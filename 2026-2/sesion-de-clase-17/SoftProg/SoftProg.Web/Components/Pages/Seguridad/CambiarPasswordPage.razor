@page "/cambiar-password"
@attribute [Authorize]
@inject ICuentaUsuarioBL CuentaUsuarioBL;
@inject ISesionService SesionService;

<PageTitle>Cambiar contraseña</PageTitle>

<div class="col-md-4 mx-auto">
    <h3 class="mb-3">Cambiar contraseña</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }
    @if (MensajeExito != null) {
        <div class="alert alert-success">@MensajeExito</div>
    }

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Contraseña actual</label>
            <InputText tabindex="1" type="password" class="form-control" @bind-Value="ViewModel.PasswordActual" />
            <ValidationMessage For="() => ViewModel.PasswordActual" />
        </div>
        <div class="mb-3">
            <label class="form-label">Nueva contraseña</label>
            <InputText tabindex="2" type="password" class="form-control" @bind-Value="ViewModel.PasswordNueva" />
            <ValidationMessage For="() => ViewModel.PasswordNueva" />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirmar nueva contraseña</label>
            <InputText tabindex="3" type="password" class="form-control" @bind-Value="ViewModel.ConfirmarPassword" />
            <ValidationMessage For="() => ViewModel.ConfirmarPassword" />
        </div>

        <button tabindex="4" type="submit" class="btn btn-primary w-100">Guardar</button>
    </EditForm>
</div>

@code {
    private CambiarPasswordViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private string? MensajeExito { get; set; }
    private int IdCuentaUsuario { get; set; }

    protected override void OnInitialized() {
        IdCuentaUsuario = SesionService.ObtenerIdCuentaUsuario();
    }

    private void Guardar() {
        try {
            CuentaUsuarioBL.CambiarPassword(IdCuentaUsuario, ViewModel.PasswordActual, ViewModel.PasswordNueva);
            MensajeError = null;
            MensajeExito = "La contraseña se cambió correctamente";
            ViewModel = new CambiarPasswordViewModel();
        } catch (BLException ex) {
            MensajeExito = null;
            MensajeError = ex.Message;
        }
    }
}
