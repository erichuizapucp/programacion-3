@page "/empleados/nuevo"
@page "/empleados/editar/{Id:int}"
@inject IEmpleadoBL EmpleadoBL;
@inject IAreaBL AreaBL;
@inject ICuentaUsuarioBL CuentaUsuarioBL;
@inject NavigationManager Nav;

<PageTitle>Empleados</PageTitle>

<h3 class="mb-3">@(Id == null ? "Nuevo empleado" : "Editar empleado")</h3>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

<EditForm Model="ViewModel" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Cuenta de usuario</label>
        <div class="d-flex gap-2">
            <InputSelect tabindex="1" class="form-select" @bind-Value="ViewModel.IdCuentaUsuario">
                <option value="0">Sin cuenta de usuario</option>
                @foreach (CuentaUsuario cuentaUsuario in CuentasUsuario) {
                    <option value="@cuentaUsuario.Id">@cuentaUsuario.UserName</option>
                }
            </InputSelect>
            <button tabindex="2" type="button" class="btn btn-outline-primary text-nowrap" @onclick="() => NuevaCuenta()">
                Nueva cuenta
            </button>
        </div>
        <div class="form-text">Si la cuenta no existe, créela primero.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">DNI</label>
        <InputText tabindex="3" class="form-control" @bind-Value="ViewModel.Dni" />
        <ValidationMessage For="() => ViewModel.Dni" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText tabindex="4" class="form-control" @bind-Value="ViewModel.Nombre" />
        <ValidationMessage For="() => ViewModel.Nombre" />
    </div>
    <div class="mb-3">
        <label class="form-label">Apellido paterno</label>
        <InputText tabindex="5" class="form-control" @bind-Value="ViewModel.ApellidoPaterno" />
        <ValidationMessage For="() => ViewModel.ApellidoPaterno" />
    </div>
    <div class="mb-3">
        <label class="form-label">Género</label>
        <InputSelect tabindex="6" class="form-select" @bind-Value="ViewModel.Genero">
            @foreach (Genero genero in Generos) {
                <option value="@genero">@genero</option>
            }
        </InputSelect>
    </div>
    <div class="mb-3">
        <label class="form-label">Fecha de nacimiento</label>
        <InputDate tabindex="7" class="form-control" @bind-Value="ViewModel.FechaNacimiento" />
        <ValidationMessage For="() => ViewModel.FechaNacimiento" />
    </div>
    <div class="mb-3">
        <label class="form-label">Área</label>
        <InputSelect tabindex="8" class="form-select" @bind-Value="ViewModel.IdArea">
            <option value="0">Seleccione un área</option>
            @foreach (Area area in Areas) {
                <option value="@area.Id">@area.Nombre</option>
            }
        </InputSelect>
        <ValidationMessage For="() => ViewModel.IdArea" />
    </div>
    <div class="mb-3">
        <label class="form-label">Cargo</label>
        <InputSelect tabindex="9" class="form-select" @bind-Value="ViewModel.Cargo">
            @foreach (Cargo cargo in Cargos) {
                <option value="@cargo">@cargo</option>
            }
        </InputSelect>
    </div>
    <div class="mb-3">
        <label class="form-label">Sueldo (S/)</label>
        <InputNumber tabindex="10" class="form-control" @bind-Value="ViewModel.Sueldo" />
        <ValidationMessage For="() => ViewModel.Sueldo" />
    </div>
    <div class="form-check mb-3">
        <InputCheckbox tabindex="11" class="form-check-input" @bind-Value="ViewModel.IsActivo" />
        <label class="form-check-label">Activo</label>
    </div>

    <button tabindex="12" type="submit" class="btn btn-primary">Guardar</button>
    <a tabindex="13" class="btn btn-outline-secondary" href="empleados">Cancelar</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromQuery(Name = "cuenta")]
    public int? IdCuentaNueva { get; set; }

    private EmpleadoViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private List<Area> Areas { get; set; } = [];
    private List<CuentaUsuario> CuentasUsuario { get; set; } = [];
    private Genero[] Generos { get; } = Enum.GetValues<Genero>();
    private Cargo[] Cargos { get; } = Enum.GetValues<Cargo>();

    protected override void OnInitialized() {
        Areas = AreaBL.FindAll();
        CuentasUsuario = CuentaUsuarioBL.FindAll();
    }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new EmpleadoViewModel();
        } else {
            Empleado? empleado = EmpleadoBL.FindById(Id.Value);
            if (empleado == null) {
                Nav.NavigateTo("/empleados");
                return;
            }
            ViewModel = new EmpleadoViewModel(empleado);
        }
        if (IdCuentaNueva != null) {
            ViewModel.IdCuentaUsuario = IdCuentaNueva.Value;
        }
    }

    private void NuevaCuenta() {
        string volver = Id == null ? "/empleados/nuevo" : $"/empleados/editar/{Id}";
        Nav.NavigateTo($"/cuentas-usuario/nuevo?volver={volver}");
    }

    private void Guardar() {
        try {
            Area area = AreaBL.FindById(ViewModel.IdArea)!;
            CuentaUsuario? cuentaUsuario = ViewModel.IdCuentaUsuario == 0
                ? null
                : CuentaUsuarioBL.FindById(ViewModel.IdCuentaUsuario);

            if (Id == null) {
                EmpleadoBL.Insert(ViewModel.ToModelo(area, cuentaUsuario));
            } else {
                EmpleadoBL.Update(ViewModel.ToModelo(area, cuentaUsuario));
            }
            Nav.NavigateTo("/empleados");
        } catch (BLException ex) {
            MensajeError = ex.Message;
        }
    }
}
