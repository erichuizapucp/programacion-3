@page "/clientes"
@inject IClienteBL ClienteBL;
@inject NavigationManager Nav;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Clientes</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Clientes</h3>
    <button tabindex="4" class="btn btn-success" @onclick="() => NuevoCliente()">
        Nuevo cliente
    </button>

</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="text-nowrap">Nombre:</label>
    <input tabindex="1" class="form-control" placeholder="Ingrese el nombre..." @bind="Filtro" />
    <button tabindex="2" class="btn btn-primary" @onclick="() => FiltrarClientes()">Filtrar</button>
    <button tabindex="3" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
</div>


@if (Clientes.Count() == 0) {
    <div class="alert alert-info">No hay clientes registrados.</div>
}
else {
    <QuickGrid Items="Clientes" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Id" Property="c => c.Id" Sortable="true" />
        <PropertyColumn Title="DNI" Property="c => c.Dni" Sortable="true" />
        <PropertyColumn Title="Nombre" Property="@(c => c.Nombre + " " + c.ApellidoPaterno)" Sortable="true" />
        <PropertyColumn Title="Categoría" Property="c => c.Categoria" Sortable="true" />
        <PropertyColumn Title="Línea de crédito (S/)" Property="c => c.LineaCredito" Format="N2"
                        Sortable="true" Align="Align.Right" />
        <TemplateColumn Title="Activo" Align="Align.Center">
            <input type="checkbox" checked="@context.IsActivo" disabled />
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            <button class="btn btn-primary btn-sm" @onclick="() => EditarCliente(context.Id)">
                Editar
            </button>
            <button class="btn btn-danger btn-sm" @onclick="() => EliminarCliente(context.Id)">
                Eliminar
            </button>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="Paginacion"></Paginator>
}

@code {
    private IQueryable<Cliente> Clientes { get; set; } = Enumerable.Empty<Cliente>().AsQueryable();
    private string Filtro { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };

    protected override void OnInitialized() {
        Clientes = ClienteBL.FindAll().AsQueryable();
    }

    private void NuevoCliente() {
        Nav.NavigateTo("/clientes/nuevo");
    }

    private void EditarCliente(int id) {
        Nav.NavigateTo($"/clientes/editar/{id}");
    }

    private void EliminarCliente(int id) {
        ClienteBL.Delete(id);
        Clientes = ClienteBL.FindAll().AsQueryable();
    }

    private void FiltrarClientes() {
        Clientes = ClienteBL.FilterByName(Filtro).AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        Clientes = ClienteBL.FindAll().AsQueryable();
    }
}
