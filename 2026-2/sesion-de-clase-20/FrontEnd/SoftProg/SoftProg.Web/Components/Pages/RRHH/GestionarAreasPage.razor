@page "/areas/nuevo"
@page "/areas/editar/{Id:int}"
@attribute [Authorize(Policy = "Areas")]
@inject IAreaService AreaService;
@inject NavigationManager Nav;

<PageTitle>Áreas</PageTitle>

<h3 class="mb-3">@(Id == null ? "Nueva área" : "Editar área")</h3>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

<EditForm Model="ViewModel" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText tabindex="1" class="form-control" @bind-Value="ViewModel.Nombre" />
        <ValidationMessage For="() => ViewModel.Nombre" />
    </div>
    <div class="form-check mb-3">
        <InputCheckbox tabindex="2" class="form-check-input" @bind-Value="ViewModel.IsActivo" />
        <label class="form-check-label">Activo</label>
    </div>

    <button tabindex="3" type="submit" class="btn btn-primary">Guardar</button>
    <a tabindex="4" class="btn btn-outline-secondary" href="areas">Cancelar</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private AreaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new AreaViewModel();
            return;
        }
        AreaViewModel? area = AreaService.FindById(Id.Value);
        if (area == null) {
            Nav.NavigateTo("/areas");
            return;
        }
        ViewModel = area;
    }

    private void Guardar() {
        try {
            if (Id == null) {
                AreaService.Insert(ViewModel);
            } else {
                AreaService.Update(ViewModel);
            }
            Nav.NavigateTo("/areas");
        } catch (ServicioException ex) {
            MensajeError = ex.Message;
        }
    }
}
